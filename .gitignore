# macOS
.DS_Store

# Editor / tooling cruft
.idea/
.vscode/
*.swp

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/
venv/
.coverage
htmlcov/

# Scratch
scratch/
*.tmp

# Generated artifacts (e.g. tooling/package-account-zips.sh output)
dist/

# Machine-local Claude Code settings (never committed)
.claude/settings.local.json

# Per-session lens-coverage state (hooks/lens-coverage/, #357/Q23) -- ephemeral,
# accumulates one file per session, never meant to be committed
.claude/.atlas-lens-coverage/

# Isolated git worktrees the Agent tool creates for subagents run with
# isolation: "worktree" -- session-local scratch, never meant to be committed
.claude/worktrees/

# atlas_reviewer controller-local state (runner ledger, single-review lock);
# default location when ATLAS_REVIEWER_STATE_DIR is unset
.atlas-reviewer-state/
