+def record(**kw) -> RoundRecord:
+    base = {
+        "repo": "example-org/example-app",
+        "pr_number": 7,
+        "head_sha": "a" * 40,
+        "lens": "tracing-correctness-and-invariants",
+        "event": "COMMENT",
+        "findings": ("L1 major calc.py:2 totals drift",),
+        "context_partial": False,
+    }
+    base.update(kw)
+    return RoundRecord(**base)
